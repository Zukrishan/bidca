# Copy to .env (git-ignored). Never commit real values.

# --- Backend (api) ---
DB_NAME=bidca
# >= 32 random bytes, e.g. `openssl rand -hex 32`. Rotate if any session leaked.
JWT_SECRET=change-me-openssl-rand-hex-32
# CORS origin; must equal the public site origin exactly (scheme + host, no trailing slash).
FRONTEND_URL=http://localhost:3100
# "production" makes the backend refuse the default admin password.
ENV=production
# Auth cookies are Secure (HTTPS-only) when ENV=production. Override only if you must, e.g.
# COOKIE_SECURE=false for a production-mode stack served over plain http on a non-localhost host.
COOKIE_SECURE=
ADMIN_EMAIL=admin@example.com
# Required when ENV=production. Use a long unique password.
ADMIN_PASSWORD=change-me-strong-password
# Optional: without these, email and image upload fall back to mocks.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Rule settings (docs/srs/02-functional.md "Settings"); empty = the default.
# Hours an account is locked after 5 failed logins (default 12).
LOGIN_LOCKOUT_HOURS=
# Days a seller is suspended for cancelling a listing that has bids: 1st, 2nd, ... time within the
# window; one more than the list = suspended until an admin reviews (default "2,7" and 365 days).
SELLER_CANCEL_SUSPENSION_DAYS=
SELLER_CANCEL_WINDOW_DAYS=
# Listings a user may submit per calendar month, Pacific time (default 30).
LISTING_CAP_PER_MONTH=
# Public launch date (YYYY-MM-DD) the free period starts on, and its length in months (default 3).
# Informational: BidCa never charges anything.
FREE_PERIOD_START=
FREE_PERIOD_MONTHS=

# --- Frontends (baked at BUILD time; changing them needs `docker compose build`) ---
# URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8100
# Canonical public site URL (used in canonical links / sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3100
