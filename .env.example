# Copy to .env (git-ignored). Never commit real values.

# --- Backend (api) ---
DB_NAME=bidca
# >= 32 random bytes, e.g. `openssl rand -hex 32`. Rotate if any session leaked.
JWT_SECRET=change-me-openssl-rand-hex-32
# CORS origin; must equal the public site origin exactly (scheme + host, no trailing slash).
FRONTEND_URL=http://localhost:3100
# "production" makes the backend refuse the default admin password.
ENV=production
# Auth cookies are Secure (HTTPS-only) when ENV=production. Override only if you must, e.g.
# COOKIE_SECURE=false for a production-mode stack served over plain http on a non-localhost host.
COOKIE_SECURE=
ADMIN_EMAIL=admin@example.com
# Required when ENV=production. Use a long unique password.
ADMIN_PASSWORD=change-me-strong-password
# Optional: without these, email and image upload fall back to mocks.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Rule settings (docs/srs/02-functional.md "Settings"); empty = the default.
# Hours an account is locked after 5 failed logins (default 12).
LOGIN_LOCKOUT_HOURS=
# After a win: hours the buyer has to answer the chat (24), lock if they don't (6),
# reminder interval while a transaction is open (6) and reminders before admins are alerted (10).
NO_RESPONSE_HOURS=
NO_RESPONSE_LOCK_HOURS=
REMINDER_INTERVAL_HOURS=
REMINDER_MAX=

# --- Frontends (baked at BUILD time; changing them needs `docker compose build`) ---
# URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8100
# Canonical public site URL (used in canonical links / sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3100
